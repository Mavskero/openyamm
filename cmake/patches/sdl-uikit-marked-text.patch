+// OpenYAMM: preedit is presentation-only; committedText remains the diff baseline.
+- (void)clearMarkedText
+{
+    if (lastMarkedText == nil) {
+        return;
+    }
+
+    lastMarkedText = nil;
+    lastMarkedTextStart = 0;
+    lastMarkedTextLength = 0;
+    if (window && SDL_GetKeyboardFocus() == window && SDL_TextInputActive(window)) {
+        SDL_SendEditingText("", 0, 0);
+    }
+}
+
+- (void)syncMarkedText
+{
+    UITextRange *markedRange = textField.markedTextRange;
+    NSString *markedText = markedRange ? [textField textInRange:markedRange] : nil;
+    if (markedText.length == 0) {
+        [self clearMarkedText];
+        return;
+    }
+    if (!textFieldFocused || !window || SDL_GetKeyboardFocus() != window || !SDL_TextInputActive(window)) {
+        return;
+    }
+
+    int start = -1;
+    int length = -1;
+    UITextRange *selection = textField.selectedTextRange;
+    if (selection) {
+        NSInteger utf16Start = [textField offsetFromPosition:markedRange.start toPosition:selection.start];
+        NSInteger utf16End = [textField offsetFromPosition:markedRange.start toPosition:selection.end];
+        if (utf16Start >= 0 && utf16End >= utf16Start && (NSUInteger)utf16End <= markedText.length) {
+            // Match Cocoa: UIKit positions count UTF-16 units, SDL counts characters.
+            NSUInteger utf32Start = [[markedText substringToIndex:(NSUInteger)utf16Start] lengthOfBytesUsingEncoding:NSUTF32StringEncoding] / 4;
+            NSUInteger utf32End = [[markedText substringToIndex:(NSUInteger)utf16End] lengthOfBytesUsingEncoding:NSUTF32StringEncoding] / 4;
+            start = (int)utf32Start;
+            length = (int)(utf32End - utf32Start);
+        }
+    }
+
+    if ([lastMarkedText isEqualToString:markedText] && lastMarkedTextStart == start && lastMarkedTextLength == length) {
+        return;
+    }
+
+    lastMarkedText = [markedText copy];
+    lastMarkedTextStart = start;
+    lastMarkedTextLength = length;
+    SDL_SendEditingText([markedText UTF8String], start, length);
+}
+
+- (void)textFieldDidUnmarkText
+{
+    if (lastMarkedText != nil && textFieldFocused && window && SDL_GetKeyboardFocus() == window && SDL_TextInputActive(window)) {
+        // If UIKit did not notify, finish through the original commit/delete diff.
+        // A prior notification or reset/stop has already cleared lastMarkedText.
+        [self textFieldTextDidChange:nil];
+    } else {
+        [self syncMarkedText];
+    }
+}
